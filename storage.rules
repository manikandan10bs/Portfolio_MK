rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'manikandan10bs@gmail.com';
    }

    // Public assets (thumbnails, certificates, resumes) can be viewed by anyone
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
