rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'manikandan10bs@gmail.com';
    }

    // Public assets (thumbnails, certificates) can be viewed by anyone
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
