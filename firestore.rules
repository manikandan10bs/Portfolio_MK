rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if requester is the authorized administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'manikandan10bs@gmail.com';
    }

    // Projects: Public visitors can view, Admin can manage
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates: Public visitors can view, Admin can manage
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profile Settings: Public visitors can view, Admin can manage
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Technical Skills: Public visitors can view, Admin can manage
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Experience Progression: Public visitors can view, Admin can manage
    match /experience/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact Form Inquiries: Visitors can submit messages, Admin can view/manage
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
