rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is the authorized administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'manikandan10bs@gmail.com';
    }

    // Projects Collection:
    // - Public visitors can only read published projects
    // - Administrator can read all (including drafts) and create, update, delete
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Certificates Collection:
    // - Public visitors can only read published certificates
    // - Administrator can read all and create, update, delete
    match /certificates/{certId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Public Profile Document:
    // - Public visitors can read
    // - Administrator can update
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for any other documents
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
